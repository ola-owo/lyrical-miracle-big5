{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "gitlab>renovate-bot/renovate-runner"],

  // update uv.lock while allowing lower bounds in pyproject
  lockFileMaintenance: {
    enabled: true,
  },
  rangeStrategy: "update-lockfile",

  // automerge when tests pass
  "platformAutomerge": true,
  packageRules: [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      automerge: true,
    },
    {
      "matchPackageNames": ["python"],
      "automerge": false
    }
  ],
}
