{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "gitlab>renovate-bot/renovate-runner"],
  platform: "gitlab",
  minimumReleaseAge: "7 days",
  prCreation: "not-pending",
  internalChecksFilter: "strict",
  internalChecksAsSuccess: true,

  // update uv.lock while allowing lower bounds in pyproject
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  rangeStrategy: "update-lockfile",

  packageRules: [
    // automerge non-breaking updates when tests pass
    {
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchIsBreaking: false,
      matchCurrentVersion: "!/^0/",
      automerge: true,
    },
    // don't automerge python updates (except patches)
    {
      matchPackageNames: ["python"],
      matchUpdateTypes: ["major", "minor"],
      automerge: false,
    },
  ],
}
